<file path="src/components/tabs/accounts-tab.tsx">
'use client';

import { useState } from 'react';
import { motion } from 'framer-motion';
import { Plus, Pencil, ArrowRightLeft, X, Check, Trash2 } from 'lucide-react';
import { Drawer, DrawerContent } from '@/components/ui/drawer';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Switch } from '@/components/ui/switch';
import { CategoryIcon, AVAILABLE_ICONS, CATEGORY_COLORS } from '@/components/icon-map';
import { useStore } from '@/lib/store';
import type { Account, AccountType } from '@/lib/types';
import { cn } from '@/lib/utils';
import { formatCurrency } from '@/lib/currencies';
import { getTotalBalance } from '@/lib/finance';
import { toast } from 'sonner';
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
} from '@/components/ui/dialog';

const ACCOUNT_TYPES: { value: AccountType; label: string }[] = [
  { value: 'cash', label: 'Cash' },
  { value: 'bank', label: 'Bank' },
  { value: 'card', label: 'Card' },
  { value: 'savings', label: 'Savings' },
  { value: 'wallet', label: 'Wallet' },
];

export function AccountsTab() {
  const { accounts, preferences, addAccount, updateAccount, deleteAccount } = useStore();
  const [editingAccount, setEditingAccount] = useState<Account | null>(null);
  const [isAdding, setIsAdding] = useState(false);
  const [transferOpen, setTransferOpen] = useState(false);

  const totalBalance = getTotalBalance(accounts);

  const confirmDelete = (acc: Account) => {
    toast('Delete this account and all its transactions?', {
      duration: 8000,
      action: {
        label: 'Delete',
        onClick: async () => {
          await deleteAccount(acc.id);
          toast.success('Account deleted');
        },
      },
      cancel: { label: 'Cancel', onClick: () => {} },
    });
  };

  return (
    <div className="flex flex-col h-full min-h-0">
      <div className="px-4 pt-4 pb-2">
        <div className="flex items-center justify-between">
          <div>
            <h1 className="text-2xl font-bold">Accounts</h1>
            <p className="text-sm text-muted-foreground mt-0.5">
              {accounts.length} account{accounts.length !== 1 ? 's' : ''}
            </p>
          </div>
          <div className="flex gap-2">
            <Button
              variant="outline"
              size="icon"
              className="rounded-xl"
              onClick={() => setTransferOpen(true)}
              disabled={accounts.length < 2}
              aria-label="Transfer between accounts"
            >
              <ArrowRightLeft className="h-4 w-4" />
            </Button>
            <Button
              size="icon"
              className="rounded-xl"
              onClick={() => setIsAdding(true)}
              aria-label="Add account"
            >
              <Plus className="h-4 w-4" />
            </Button>
          </div>
        </div>
      </div>

      <div className="px-4 pt-2">
        <div className="rounded-3xl bg-gradient-to-br from-primary to-primary/70 text-primary-foreground p-5 shadow-lg shadow-primary/20">
          <p className="text-sm opacity-90 font-medium">Total Net Worth</p>
          <p className="text-3xl font-bold mt-1 tabular-nums">
            {formatCurrency(totalBalance, preferences.currencySymbol)}
          </p>
        </div>
      </div>

      <div className="flex-1 min-h-0 overflow-y-auto no-scrollbar px-4 pt-3 pb-40">
        <div className="flex flex-col gap-3">
          {accounts.map((acc, i) => (
            <motion.div
              key={acc.id}
              initial={{ opacity: 0, y: 10 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: i * 0.05 }}
              className="bg-card rounded-2xl border border-border/40 p-4"
            >
              <div className="flex items-start gap-3">
                <div
                  className="h-12 w-12 rounded-2xl flex items-center justify-center shrink-0"
                  style={{ backgroundColor: `${acc.color}1A` }}
                >
                  <span style={{ color: acc.color }}>
                    <CategoryIcon name={acc.icon} size={24} />
                  </span>
                </div>
                <div className="flex-1 min-w-0">
                  <div className="flex items-center gap-2">
                    <span className="font-semibold text-sm">{acc.name}</span>
                    <span className="text-xs px-2 py-0.5 rounded-full bg-muted text-muted-foreground capitalize">
                      {acc.type}
                    </span>
                  </div>
                  <p
                    className={cn(
                      'text-lg font-bold tabular-nums mt-1',
                      acc.balance >= 0 ? 'text-foreground' : 'text-expense'
                    )}
                  >
                    {formatCurrency(acc.balance, preferences.currencySymbol)}
                  </p>
                </div>
                <div className="flex flex-col gap-1">
                  <button
                    onClick={() => setEditingAccount(acc)}
                    className="p-2 rounded-xl hover:bg-muted transition-colors"
                    aria-label="Edit account"
                  >
                    <Pencil className="h-4 w-4 text-muted-foreground" />
                  </button>
                  <button
                    onClick={() => confirmDelete(acc)}
                    className="p-2 rounded-xl hover:bg-destructive/10 transition-colors"
                    aria-label="Delete account"
                  >
                    <Trash2 className="h-4 w-4 text-destructive" />
                  </button>
                </div>
              </div>
              {!acc.isIncludedInTotal && (
                <p className="text-xs text-muted-foreground mt-2">Excluded from total</p>
              )}
            </motion.div>
          ))}
        </div>
      </div>

      <AccountSheet
        open={isAdding || editingAccount !== null}
        account={editingAccount}
        onOpenChange={(open) => {
          if (!open) {
            setIsAdding(false);
            setEditingAccount(null);
          }
        }}
        onSave={(data, id) => {
          if (id) {
            updateAccount(id, data);
            toast.success('Account updated');
          } else {
            addAccount(data);
            toast.success('Account added');
          }
          setIsAdding(false);
          setEditingAccount(null);
        }}
      />

      <TransferDialog open={transferOpen} onOpenChange={setTransferOpen} />
    </div>
  );
}

function AccountSheet({
  open,
  account,
  onOpenChange,
  onSave,
}: {
  open: boolean;
  account: Account | null;
  onOpenChange: (open: boolean) => void;
  onSave: (data: Omit<Account, 'id' | 'createdAt'>, id?: string) => void;
}) {
  const { preferences } = useStore();
  const formKey = open ? account?.id ?? 'new' : 'closed';

  return (
    <Drawer open={open} onOpenChange={onOpenChange}>
      <DrawerContent className="rounded-t-[2rem]">
        <div
          className="mx-auto w-full max-w-md px-4 pb-[max(env(safe-area-inset-bottom),1rem)] pt-2 overflow-y-auto no-scrollbar"
          style={{ maxHeight: '85vh' }}
        >
          <h2 className="text-xl font-bold mb-4">
            {account ? 'Edit Account' : 'New Account'}
          </h2>
          <AccountForm
            key={formKey}
            initialName={account?.name ?? ''}
            initialType={account?.type ?? 'cash'}
            initialBalance={account?.initialBalance ?? 0}
            currentBalance={account?.balance ?? 0}
            isEditing={!!account}
            initialIcon={account?.icon ?? 'Banknote'}
            initialColor={account?.color ?? '#22C55E'}
            initialIncluded={account?.isIncludedInTotal ?? true}
            currencySymbol={preferences.currencySymbol}
            currencyCode={preferences.currency}
            onCancel={() => onOpenChange(false)}
            onSubmit={(data) => onSave(data, account?.id)}
          />
        </div>
      </DrawerContent>
    </Drawer>
  );
}

function AccountForm({
  initialName,
  initialType,
  initialBalance,
  currentBalance,
  isEditing,
  initialIcon,
  initialColor,
  initialIncluded,
  currencySymbol,
  currencyCode,
  onCancel,
  onSubmit,
}: {
  initialName: string;
  initialType: AccountType;
  initialBalance: number;
  currentBalance: number;
  isEditing: boolean;
  initialIcon: string;
  initialColor: string;
  initialIncluded: boolean;
  currencySymbol: string;
  currencyCode: string;
  onCancel: () => void;
  onSubmit: (data: Omit<Account, 'id' | 'createdAt'>) => void;
}) {
  const [name, setName] = useState(initialName);
  const [type, setType] = useState<AccountType>(initialType);
  const [initialBalanceInput, setInitialBalanceInput] = useState(String(initialBalance));
  const [icon, setIcon] = useState(initialIcon);
  const [color, setColor] = useState(initialColor);
  const [isIncludedInTotal, setIsIncludedInTotal] = useState(initialIncluded);

  // Preview of what the *current* balance will be after saving.
  const parsedInitial = parseFloat(initialBalanceInput) || 0;
  const previewDelta = parsedInitial - initialBalance;
  const previewBalance = isEditing ? currentBalance + previewDelta : parsedInitial;

  const handleSubmit = () => {
    if (!name.trim()) {
      toast.error('Please enter an account name');
      return;
    }
    const newInitial = parsedInitial;
    const newBalance = isEditing ? currentBalance + (newInitial - initialBalance) : newInitial;

    onSubmit({
      name: name.trim(),
      type,
      balance: newBalance,
      initialBalance: newInitial,
      currency: currencyCode,
      icon,
      color,
      isIncludedInTotal,
    });
  };

  return (
    <div className="flex flex-col gap-4">
      <div className="flex items-center gap-3 p-4 rounded-2xl bg-muted/40">
        <div
          className="h-12 w-12 rounded-2xl flex items-center justify-center"
          style={{ backgroundColor: `${color}1A` }}
        >
          <span style={{ color }}>
            <CategoryIcon name={icon} size={24} />
          </span>
        </div>
        <div>
          <p className="font-semibold text-sm">{name || 'Account Name'}</p>
          <p className="text-xs text-muted-foreground capitalize">{type}</p>
        </div>
      </div>

      <div>
        <Label className="text-xs text-muted-foreground">Account Name</Label>
        <Input
          value={name}
          onChange={(e) => setName(e.target.value)}
          placeholder="e.g. Main Wallet"
          className="mt-1 rounded-xl"
        />
      </div>

      <div>
        <Label className="text-xs text-muted-foreground">Account Type</Label>
        <div className="flex flex-wrap gap-2 mt-1">
          {ACCOUNT_TYPES.map((t) => (
            <button
              key={t.value}
              onClick={() => setType(t.value)}
              className={cn(
                'px-3 py-2 rounded-xl text-sm font-medium transition-all',
                type === t.value
                  ? 'bg-primary text-primary-foreground'
                  : 'bg-muted text-muted-foreground'
              )}
            >
              {t.label}
            </button>
          ))}
        </div>
      </div>

      <div>
        <Label className="text-xs text-muted-foreground">Initial Balance</Label>
        <div className="relative mt-1">
          <span className="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground">
            {currencySymbol}
          </span>
          <Input
            type="number"
            value={initialBalanceInput}
            onChange={(e) => setInitialBalanceInput(e.target.value)}
            placeholder="0.00"
            className="rounded-xl pl-8"
          />
        </div>
        {isEditing && (
          <p className="text-xs text-muted-foreground mt-2">
            Current balance:{' '}
            <span className="font-medium text-foreground tabular-nums">
              {formatCurrency(currentBalance, currencySymbol)}
            </span>
            {previewDelta !== 0 && (
              <>
                {' → '}
                <span className="font-medium text-foreground tabular-nums">
                  {formatCurrency(previewBalance, currencySymbol)}
                </span>
              </>
            )}
          </p>
        )}
      </div>

      <div>
        <Label className="text-xs text-muted-foreground">Icon</Label>
        <div className="grid grid-cols-8 gap-2 mt-1">
          {AVAILABLE_ICONS.slice(0, 16).map((iconName) => (
            <button
              key={iconName}
              onClick={() => setIcon(iconName)}
              aria-label={`Icon ${iconName}`}
              className={cn(
                'h-10 w-10 rounded-xl flex items-center justify-center transition-all',
                icon === iconName ? 'bg-primary text-primary-foreground' : 'bg-muted'
              )}
            >
              <CategoryIcon name={iconName} size={18} />
            </button>
          ))}
        </div>
      </div>

      <div>
        <Label className="text-xs text-muted-foreground">Color</Label>
        <div className="flex flex-wrap gap-2 mt-1">
          {CATEGORY_COLORS.slice(0, 12).map((c) => (
            <button
              key={c}
              onClick={() => setColor(c)}
              aria-label={`Color ${c}`}
              className={cn(
                'h-8 w-8 rounded-full transition-all',
                color === c && 'ring-2 ring-offset-2 ring-ring scale-110'
              )}
              style={{ backgroundColor: c }}
            />
          ))}
        </div>
      </div>

      <div className="flex items-center justify-between">
        <Label className="text-sm">Include in net worth total</Label>
        <Switch checked={isIncludedInTotal} onCheckedChange={setIsIncludedInTotal} />
      </div>

      <div className="flex gap-2 mt-2">
        <Button variant="outline" className="flex-1 rounded-xl" onClick={onCancel}>
          <X className="h-4 w-4 mr-1" /> Cancel
        </Button>
        <Button className="flex-1 rounded-xl" onClick={handleSubmit}>
          <Check className="h-4 w-4 mr-1" /> Save
        </Button>
      </div>
    </div>
  );
}

function TransferDialog({
  open,
  onOpenChange,
}: {
  open: boolean;
  onOpenChange: (open: boolean) => void;
}) {
  const { accounts, preferences, addTransaction } = useStore();
  const [fromId, setFromId] = useState('');
  const [toId, setToId] = useState('');
  const [amount, setAmount] = useState('');

  const handleTransfer = () => {
    const amt = parseFloat(amount) || 0;
    if (amt <= 0) {
      toast.error('Enter a valid amount');
      return;
    }
    if (!fromId || !toId) {
      toast.error('Select both accounts');
      return;
    }
    if (fromId === toId) {
      toast.error('Choose different accounts');
      return;
    }
    addTransaction({
      type: 'transfer',
      amount: amt,
      accountId: fromId,
      toAccountId: toId,
      categoryId: null,
      date: Date.now(),
      note: 'Transfer',
      receiptUrl: null,
      isExcludedFromStats: true,
      isExcludedFromBudget: true,
    });
    toast.success('Transfer completed');
    setAmount('');
    setFromId('');
    setToId('');
    onOpenChange(false);
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="rounded-3xl">
        <DialogHeader>
          <DialogTitle>Transfer Between Accounts</DialogTitle>
        </DialogHeader>
        <div className="flex flex-col gap-4 py-2">
          <div>
            <Label className="text-xs text-muted-foreground">From</Label>
            <select
              value={fromId}
              onChange={(e) => setFromId(e.target.value)}
              className="w-full mt-1 rounded-xl border border-input bg-background px-3 py-2.5 text-sm"
            >
              <option value="">Select account</option>
              {accounts.map((a) => (
                <option key={a.id} value={a.id}>
                  {a.name} ({formatCurrency(a.balance, preferences.currencySymbol)})
                </option>
              ))}
            </select>
          </div>
          <div>
            <Label className="text-xs text-muted-foreground">To</Label>
            <select
              value={toId}
              onChange={(e) => setToId(e.target.value)}
              className="w-full mt-1 rounded-xl border border-input bg-background px-3 py-2.5 text-sm"
            >
              <option value="">Select account</option>
              {accounts.map((a) => (
                <option key={a.id} value={a.id}>
                  {a.name} ({formatCurrency(a.balance, preferences.currencySymbol)})
                </option>
              ))}
            </select>
          </div>
          <div>
            <Label className="text-xs text-muted-foreground">Amount</Label>
            <div className="relative mt-1">
              <span className="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground">
                {preferences.currencySymbol}
              </span>
              <Input
                type="number"
                value={amount}
                onChange={(e) => setAmount(e.target.value)}
                placeholder="0.00"
                className="rounded-xl pl-8"
              />
            </div>
          </div>
        </div>
        <DialogFooter>
          <Button variant="outline" onClick={() => onOpenChange(false)}>
            Cancel
          </Button>
          <Button onClick={handleTransfer}>
            <ArrowRightLeft className="h-4 w-4 mr-1" /> Transfer
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="src/components/tabs/budgets-view.tsx">
'use client';

import { useState, useMemo } from 'react';
import { motion } from 'framer-motion';
import { Plus, Pencil, Trash2, Target, AlertTriangle, X, Check } from 'lucide-react';
import { Drawer, DrawerContent } from '@/components/ui/drawer';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Switch } from '@/components/ui/switch';
import { CategoryIcon } from '@/components/icon-map';
import { useStore } from '@/lib/store';
import type { Budget, Category } from '@/lib/types';
import { cn } from '@/lib/utils';
import { formatCurrency } from '@/lib/currencies';
import {
  getBudgetProgress,
  getMonthTotalSpent,
  formatMonthYear,
  monthYearKey,
} from '@/lib/finance';
import { toast } from 'sonner';

export function BudgetsView() {
  const { budgets, transactions, categories, preferences, addBudget, updateBudget, deleteBudget } =
    useStore();
  const [editing, setEditing] = useState<Budget | null>(null);
  const [isAdding, setIsAdding] = useState(false);

  const currentMonth = monthYearKey(Date.now());
  const monthBudgets = budgets.filter((b) => b.monthYear === currentMonth);

  /**
   * If an "overall" budget exists (categoryId === null), it supersedes the sum
   * of category budgets — otherwise the overall card would double-count every
   * category expense. Otherwise, sum category budget amounts.
   */
  const overallBudget = monthBudgets.find((b) => b.categoryId === null);
  const totalBudget = overallBudget
    ? overallBudget.amount
    : monthBudgets.reduce((s, b) => s + b.amount, 0);

  // Compute spent from raw transactions — do NOT sum per-budget progress.
  const totalSpent = useMemo(
    () => getMonthTotalSpent(transactions, currentMonth),
    [transactions, currentMonth]
  );
  const overallPercentage = totalBudget > 0 ? (totalSpent / totalBudget) * 100 : 0;

  const handleSave = (data: Omit<Budget, 'id'>, id?: string) => {
    const duplicate = budgets.find(
      (b) =>
        b.monthYear === currentMonth &&
        b.categoryId === data.categoryId &&
        b.id !== id
    );
    if (duplicate) {
      toast.error(
        data.categoryId
          ? 'A budget for this category already exists this month'
          : 'An overall budget already exists this month'
      );
      return;
    }
    if (id) {
      updateBudget(id, data);
      toast.success('Budget updated');
    } else {
      addBudget(data);
      toast.success('Budget added');
    }
    setIsAdding(false);
    setEditing(null);
  };

  return (
    <div className="flex flex-col gap-3">
      <div className="rounded-3xl bg-gradient-to-br from-primary to-primary/70 text-primary-foreground p-5 shadow-lg shadow-primary/20">
        <div className="flex items-center gap-2 mb-2">
          <Target className="h-5 w-5" />
          <span className="text-sm font-medium opacity-90">
            Overall Budget — {formatMonthYear(currentMonth)}
          </span>
        </div>
        <p className="text-3xl font-bold tabular-nums">
          {formatCurrency(totalSpent, preferences.currencySymbol)}
          <span className="text-lg opacity-75 font-normal">
            {' '}
            / {formatCurrency(totalBudget, preferences.currencySymbol)}
          </span>
        </p>
        <div className="mt-3 h-2.5 rounded-full bg-white/20 overflow-hidden">
          <motion.div
            initial={{ width: 0 }}
            animate={{ width: `${Math.min(overallPercentage, 100)}%` }}
            transition={{ type: 'spring', stiffness: 100, damping: 20 }}
            className={cn(
              'h-full rounded-full transition-colors',
              overallPercentage >= 100
                ? 'bg-destructive'
                : overallPercentage >= 80
                ? 'bg-warning'
                : 'bg-white'
            )}
          />
        </div>
        <p className="text-xs opacity-75 mt-2">
          {totalBudget === 0
            ? 'No budgets set for this month yet.'
            : overallPercentage >= 100
            ? 'Budget exceeded! Consider adjusting your spending.'
            : `${Math.max(0, 100 - overallPercentage).toFixed(0)}% remaining`}
        </p>
      </div>

      <Button
        variant="outline"
        className="rounded-2xl border-dashed"
        onClick={() => setIsAdding(true)}
      >
        <Plus className="h-4 w-4 mr-2" /> Add Budget
      </Button>

      {monthBudgets.length === 0 ? (
        <div className="flex flex-col items-center justify-center py-16 text-center">
          <div className="h-16 w-16 rounded-full bg-muted flex items-center justify-center mb-4">
            <Target className="h-8 w-8 text-muted-foreground" />
          </div>
          <p className="text-sm text-muted-foreground">No budgets set for this month yet</p>
        </div>
      ) : (
        <div className="flex flex-col gap-3">
          {monthBudgets.map((budget, i) => {
            const cat = categories.find((c) => c.id === budget.categoryId);
            const progress = getBudgetProgress(budget, transactions, categories);
            return (
              <motion.div
                key={budget.id}
                initial={{ opacity: 0, y: 10 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ delay: i * 0.05 }}
                className="bg-card rounded-2xl border border-border/40 p-4"
              >
                <div className="flex items-center gap-3 mb-3">
                  <div
                    className="h-10 w-10 rounded-xl flex items-center justify-center shrink-0"
                    style={{
                      backgroundColor: cat ? `${cat.color}1A` : 'hsl(var(--muted))',
                    }}
                  >
                    {cat ? (
                      <span style={{ color: cat.color }}>
                        <CategoryIcon name={cat.icon} size={20} />
                      </span>
                    ) : (
                      <Target className="h-5 w-5 text-primary" />
                    )}
                  </div>
                  <div className="flex-1 min-w-0">
                    <p className="font-semibold text-sm">{cat?.name ?? 'Overall Budget'}</p>
                    <p className="text-xs text-muted-foreground tabular-nums">
                      {formatCurrency(progress.spent, preferences.currencySymbol)} of{' '}
                      {formatCurrency(budget.amount, preferences.currencySymbol)}
                    </p>
                  </div>
                  <div className="flex gap-1">
                    <button
                      onClick={() => setEditing(budget)}
                      className="p-2 rounded-xl hover:bg-muted"
                    >
                      <Pencil className="h-4 w-4 text-muted-foreground" />
                    </button>
                    <button
                      onClick={() => {
                        toast('Delete this budget?', {
                          duration: 6000,
                          action: {
                            label: 'Delete',
                            onClick: () => {
                              deleteBudget(budget.id);
                              toast.success('Budget deleted');
                            },
                          },
                          cancel: { label: 'Cancel', onClick: () => {} },
                        });
                      }}
                      className="p-2 rounded-xl hover:bg-destructive/10"
                    >
                      <Trash2 className="h-4 w-4 text-destructive" />
                    </button>
                  </div>
                </div>

                <div className="h-2.5 rounded-full bg-muted overflow-hidden">
                  <motion.div
                    initial={{ width: 0 }}
                    animate={{ width: `${progress.percentage}%` }}
                    transition={{ type: 'spring', stiffness: 100, damping: 20 }}
                    className={cn(
                      'h-full rounded-full',
                      progress.isOver
                        ? 'bg-destructive'
                        : progress.isWarning
                        ? 'bg-warning'
                        : 'bg-primary'
                    )}
                  />
                </div>
                <div className="flex items-center justify-between mt-2">
                  <span className="text-xs text-muted-foreground tabular-nums">
                    {progress.percentage.toFixed(0)}% used
                  </span>
                  <span
                    className={cn(
                      'text-xs font-medium tabular-nums',
                      progress.isOver
                        ? 'text-destructive'
                        : progress.isWarning
                        ? 'text-warning'
                        : 'text-muted-foreground'
                    )}
                  >
                    {progress.isOver ? (
                      <span className="flex items-center gap-1">
                        <AlertTriangle className="h-3 w-3" />
                        Over by{' '}
                        {formatCurrency(
                          progress.spent - budget.amount,
                          preferences.currencySymbol
                        )}
                      </span>
                    ) : (
                      `${formatCurrency(progress.remaining, preferences.currencySymbol)} left`
                    )}
                  </span>
                </div>
              </motion.div>
            );
          })}
        </div>
      )}

      <BudgetSheet
        open={isAdding || editing !== null}
        budget={editing}
        onOpenChange={(open) => {
          if (!open) {
            setIsAdding(false);
            setEditing(null);
          }
        }}
        onSave={handleSave}
      />
    </div>
  );
}

function BudgetSheet({
  open,
  budget,
  onOpenChange,
  onSave,
}: {
  open: boolean;
  budget: Budget | null;
  onOpenChange: (open: boolean) => void;
  onSave: (data: Omit<Budget, 'id'>, id?: string) => void;
}) {
  const { categories, preferences } = useStore();
  const formKey = open ? budget?.id ?? 'new' : 'closed';

  return (
    <Drawer open={open} onOpenChange={onOpenChange}>
      <DrawerContent className="rounded-t-[2rem]">
        <div className="mx-auto w-full max-w-md px-4 pb-[max(env(safe-area-inset-bottom),1rem)] pt-2">
          <h2 className="text-xl font-bold mb-4">{budget ? 'Edit Budget' : 'New Budget'}</h2>
          <BudgetForm
            key={formKey}
            initialAmount={budget?.amount ?? 0}
            initialCategoryId={budget?.categoryId ?? null}
            initialCarryOver={budget?.carryOver ?? false}
            currencySymbol={preferences.currencySymbol}
            categories={categories}
            onCancel={() => onOpenChange(false)}
            onSubmit={(data) =>
              onSave(
                {
                  ...data,
                  monthYear: monthYearKey(Date.now()),
                  period: 'monthly',
                },
                budget?.id
              )
            }
          />
        </div>
      </DrawerContent>
    </Drawer>
  );
}

function BudgetForm({
  initialAmount,
  initialCategoryId,
  initialCarryOver,
  currencySymbol,
  categories,
  onCancel,
  onSubmit,
}: {
  initialAmount: number;
  initialCategoryId: string | null;
  initialCarryOver: boolean;
  currencySymbol: string;
  categories: Category[];
  onCancel: () => void;
  onSubmit: (data: { amount: number; categoryId: string | null; carryOver: boolean }) => void;
}) {
  const [amount, setAmount] = useState(String(initialAmount));
  const [categoryId, setCategoryId] = useState<string | null>(initialCategoryId);
  const [carryOver, setCarryOver] = useState(initialCarryOver);

  const expenseCategories = categories.filter(
    (c) => c.type === 'expense' && !c.parentId && !c.isHidden
  );

  const handleSubmit = () => {
    const amt = parseFloat(amount) || 0;
    if (amt <= 0) {
      toast.error('Enter a valid amount');
      return;
    }
    onSubmit({ amount: amt, categoryId, carryOver });
  };

  return (
    <div className="flex flex-col gap-4">
      <div>
        <Label className="text-xs text-muted-foreground">Budget for Category</Label>
        <div className="flex flex-wrap gap-2 mt-1">
          <button
            onClick={() => setCategoryId(null)}
            className={cn(
              'px-3 py-2 rounded-xl text-sm font-medium transition-all',
              categoryId === null
                ? 'bg-primary text-primary-foreground'
                : 'bg-muted text-muted-foreground'
            )}
          >
            Overall
          </button>
          {expenseCategories.map((cat) => (
            <button
              key={cat.id}
              onClick={() => setCategoryId(cat.id)}
              className={cn(
                'flex items-center gap-1.5 px-3 py-2 rounded-xl text-sm font-medium transition-all',
                categoryId === cat.id
                  ? 'bg-primary text-primary-foreground'
                  : 'bg-muted text-muted-foreground'
              )}
            >
              <span style={{ color: categoryId === cat.id ? 'inherit' : cat.color }}>
                <CategoryIcon name={cat.icon} size={14} />
              </span>
              {cat.name}
            </button>
          ))}
        </div>
      </div>

      <div>
        <Label className="text-xs text-muted-foreground">Monthly Budget Amount</Label>
        <div className="relative mt-1">
          <span className="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground">
            {currencySymbol}
          </span>
          <Input
            type="number"
            value={amount}
            onChange={(e) => setAmount(e.target.value)}
            placeholder="0.00"
            className="rounded-xl pl-8 text-lg"
          />
        </div>
      </div>

      <div className="flex items-center justify-between">
        <div>
          <Label className="text-sm">Carry over</Label>
          <p className="text-xs text-muted-foreground">Roll over unused budget to next month</p>
        </div>
        <Switch checked={carryOver} onCheckedChange={setCarryOver} />
      </div>

      <div className="flex gap-2 mt-2">
        <Button variant="outline" className="flex-1 rounded-xl" onClick={onCancel}>
          <X className="h-4 w-4 mr-1" /> Cancel
        </Button>
        <Button className="flex-1 rounded-xl" onClick={handleSubmit}>
          <Check className="h-4 w-4 mr-1" /> Save
        </Button>
      </div>
    </div>
  );
}
</file>

