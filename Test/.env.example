# Copy this file to .env and fill in your own values.
# .env itself is gitignored — see ../../.gitignore

# ---- Vite / Firebase (app build) — for Test to know where to reach ----
KALCY_URL=https://kalcy.vercel.app

# ---- Playwright / pytest (test run) ----
# These must NOT be prefixed with VITE_ (they are for tests only).
KALCY_TEST_EMAIL=
KALCY_TEST_PASSWORD=

# ---- Optional — set to 1 for a clean slate after every test ----
KALCY_CLEANUP=1